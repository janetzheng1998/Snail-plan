DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# 可选：当静态页面部署在 EdgeOne、API 部署在 Vercel 时填写。
# 示例：https://your-vercel-domain.vercel.app/api/organize
NEXT_PUBLIC_ORGANIZE_API_URL=

# 可选：限制允许调用 API 的网页来源。留空时默认允许跨域调用，方便 EdgeOne 页面访问 Vercel API。
# 示例：https://your-edgeone-domain.example.com
ORGANIZE_API_ALLOWED_ORIGIN=
